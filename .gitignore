# Quarto output and disposable generated sources (including example sites)
.quarto/
_site/
_site-docs/
_freeze/
_generated/
.scratch/

# Local environments and dependency installations; keep pixi.lock tracked
.pixi/
.venv/
venv/
node_modules/

# Python bytecode, tooling caches, and coverage reports
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Local credentials and agent state; allow shareable environment templates
.env
.env.*
!.env.example
!.env.sample
!.env.template


# Python release artifacts (local builds use .scratch/)
build/
dist/
*.egg-info/

# Operating-system metadata and editor backup files
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
